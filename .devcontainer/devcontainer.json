{
  "name": "restaurant-workforce-optimizer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install -e '.[dev]' && python scripts/seed_demo.py --days 120 --employees 24 --reset",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "API + dashboard", "onAutoForward": "openPreview" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },
  "remoteUser": "vscode"
}
