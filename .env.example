# copy to .env and edit. Never commit the real file.
RWO_ENV=dev                       # dev | test | prod
RWO_DATABASE_URL=sqlite+aiosqlite:///./rwo.db
# RWO_DATABASE_URL=postgresql+asyncpg://rwo:rwo@db:5432/rwo

# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
RWO_SECRET_KEY=dev-insecure-secret-change-me-0000000000
RWO_ACCESS_TTL_MINUTES=15
RWO_REFRESH_TTL_DAYS=14

RWO_ADMIN_EMAIL=admin@rwo.app
RWO_ADMIN_PASSWORD=ChangeMe!Admin123

RWO_CORS_ORIGINS=http://localhost:8000
RWO_TRUSTED_HOSTS=*
RWO_RATE_LIMIT_PER_MINUTE=240
RWO_AUTH_RATE_LIMIT_PER_MINUTE=12

RWO_OPEN_HOUR=10
RWO_CLOSE_HOUR=23
RWO_HORIZON_DAYS_MAX=21
RWO_SOLVER_TIME_LIMIT_SECONDS=30
